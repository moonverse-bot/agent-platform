# 复制成 .env 后按需修改;.env 已在 .gitignore 中,不会被提交

# 数据层:本地开发默认 SQLite,生产切 Postgres
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# Redis:留空则限流自动退化为进程内实现
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# 鉴权密钥:部署前必须换成随机串,长度至少 32 字节(HS256 的要求)
JWT_SECRET=dev-only-secret-change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 大模型(DeepSeek,OpenAI 兼容协议)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOOL_ROUNDS=4

# 限流:每用户每分钟允许的对话请求数
RATE_LIMIT_PER_MINUTE=20

# 首次启动时创建演示账号 demo@example.com / password-123(登录页默认就填这组信息)
# 线上部署务必设为 false,否则任何人都能用已知密码登录这个账号
SEED_DEMO_DATA=true

# ---- 知识库检索 ----
# hybrid: 关键词命中 + 语义向量召回(整篇 + 段落),按排名融合;keyword: 只走关键词;vector: 只走向量
RETRIEVAL_MODE=hybrid
# 送进模型的文章条数;两路各自先取多少候选由 RETRIEVAL_CANDIDATES 控制
RETRIEVAL_TOP_K=3
# 向量最低相似度,留 0 表示用当前 Embedding 模型的建议阈值
RETRIEVAL_MIN_VECTOR_SCORE=0
# auto 按数据库自动选:Postgres 用 pgvector,SQLite 用内置的 JSON + 进程内余弦;none 关闭向量检索
VECTOR_BACKEND=auto

# ---- 文档切块 ----
# 长文档先切成段,每段单独出一个向量,命中的那一段会作为 matched_chunk 返回。
# 块太小装不下一个完整答案,块太大一个向量里混的主题就多、精度就低。
# 设 KNOWLEDGE_CHUNK_SIZE=0 关闭切块,退回「整篇一个向量」。
KNOWLEDGE_CHUNK_SIZE=300
KNOWLEDGE_CHUNK_OVERLAP=60

# ---- 重排 ----
# 召回之后把头部候选按与问题的相关度重排一遍。它是纯增强:关掉或报错都会回到召回顺序。
# lexical: 零依赖的词法覆盖度(默认,但它不是 cross-encoder);api: OpenAI 兼容的 /rerank 服务
RERANK_ENABLED=true
RERANK_PROVIDER=lexical
# 送进重排的候选条数:重排比召回贵,只重排头部这一段最划算
RERANK_CANDIDATE_LIMIT=10
# 只有 RERANK_PROVIDER=api 才用得到下面三项(Cohere / 硅基流动 / Jina 都是同一套协议)
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=

# Embedding(任意 OpenAI 兼容的 /embeddings 服务)。两个都留空时会用离线哈希向量兜底,
# 它能跑通整条链路但只能做词形匹配,不是真正的语义检索。
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
# 常见选择(填好 Key 与模型名即可,不用改代码):
#   硅基流动   https://api.siliconflow.cn/v1   BAAI/bge-m3            (1024 维)
#   智谱       https://open.bigmodel.cn/api/paas/v4   embedding-3     (2048 维)
#   OpenAI     https://api.openai.com/v1       text-embedding-3-small (1536 维)
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
